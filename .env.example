# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID организаторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# Прокси для Telegram API, если api.telegram.org недоступен из твоей сети (http://host:port или socks5://host:port)
BOT_PROXY=
# HTTPS-адрес мини аппа (адрес туннеля cloudflared/ngrok или https://DOMAIN на сервере). Пусто — без мини аппа.
WEBAPP_URL=

# ===== Сервер (docker compose, см. docs/DEPLOY.md) =====
# Домен, на который Caddy получит HTTPS-сертификат. Свой домен (A-запись на IP сервера)
# или бесплатный вида 1-2-3-4.sslip.io, где 1.2.3.4 — IP сервера. Локально не нужен.
DOMAIN=
# Куда бот присылает ежедневный бэкап (ваш Telegram ID или ID закрытого чата организаторов). Пусто — не присылать.
BACKUP_CHAT_ID=

# ===== LLM (любой OpenAI-совместимый API) =====
# Названия моделей ниже — примеры, актуальные смотри на сайте провайдера.
#
# Можно указать несколько моделей через запятую: если первая недоступна (убрали из бесплатных,
# кончился лимит), бот возьмёт следующую.
#
# OpenRouter: бесплатные модели имеют суффикс :free, актуальный список: https://openrouter.ai/models?q=free
# Бесплатные модели там часто появляются и исчезают, поэтому лучше указать 2–3 штуки.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=первая-модель:free,вторая-модель:free
#
# NVIDIA (https://build.nvidia.com):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
#
# Gemini (https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
#
# DeepSeek (https://platform.deepseek.com, платно, но дёшево):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# Локальная модель через Ollama (ключ не нужен):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
# Если модель ругается на response_format, поставь false
LLM_JSON_MODE=true
# Сколько работ проверяется параллельно. Для бесплатных моделей 1–2 (жёсткие лимиты),
# для платного ключа OpenRouter на 100+ участников — 5–10.
CHECK_CONCURRENCY=1

# ===== Прочее =====
DEFAULT_MAX_ATTEMPTS=3
# Подстроки, по которым в шаблоне ищутся ячейки-задания (через |). Строка "..." работает всегда.
# TASK_MARKERS=пишите ваш код|ваш код здесь|your code here
TIMEZONE=Europe/Moscow
PORT=8080
DATA_DIR=data
# Только для отладки мини аппа в обычном браузере (без Telegram): подставляет этого пользователя.
# В «боевом» запуске оставь пустым!
DEV_USER_ID=
